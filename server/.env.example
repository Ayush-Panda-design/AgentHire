# ── Required ──────────────────────────────────────────────────────────────────
PORT=5000

# MongoDB Atlas connection string (free tier works fine)
# Create at: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agenthire?retryWrites=true&w=majority

# JWT secrets — any long random strings work (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=replace_with_any_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string

# Razorpay — test mode keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini — from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_key_here

CLIENT_URL=http://localhost:5173

# ── Optional (Google OAuth — leave blank to skip, email/password still works) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


